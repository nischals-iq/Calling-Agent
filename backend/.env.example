# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/Calling-agent?schema=public"

# JWT Authentication
JWT_SECRET="calling_agent_jwt_super_secret_production_key_2026"
JWT_EXPIRES_IN="7d"

# Integration Encryption Vault (AES-256-GCM)
# 32-byte or string encryption key used to encrypt client API secrets, developer tokens, and OAuth tokens at rest
INTEGRATION_ENCRYPTION_KEY="your_secure_32_byte_vault_encryption_key_here"

# OAuth State Signing Secret (HMAC-SHA256 CSRF protection)
OAUTH_STATE_SECRET="your_secure_oauth_state_signing_secret_here"

# Application Base URLs
BACKEND_BASE_URL="https://b2kku2c1-8000.inc1.devtunnels.ms"
FRONTEND_BASE_URL="https://b2kku2c1-3000.inc1.devtunnels.ms"

# Meta (Facebook / Instagram) OAuth Configuration
# Required Meta Developer App Settings:
# In Meta App Dashboard -> App Settings / Facebook Login Settings:
# Add this exact URL to "Valid OAuth Redirect URIs":
# Development: http://localhost:8000/api/integrations/meta/callback
# Production:  ${BACKEND_BASE_URL}/api/integrations/meta/callback
